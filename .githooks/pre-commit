#!/bin/sh
# The gates that may change the commit. Git freezes the commit's contents the moment this hook
# returns, so anything staged afterwards — inside commit-msg — stays in the index instead of
# reaching the commit. The version bump edits and stages package.json, so it lives here.
set -e

root=$(dirname "$0")/..

. "$(dirname "$0")/step.sh"

# The mirrors are generated, so this gate repairs them before any later gate reads them.
step "[commit-tokens]" node "$root/scripts/build-tokens.js"

git add -- common/ux/tokens.generated.css common/ux/Const/Const.generated.ts \
    src/shared/styles/tokens.generated.scss rules/tokens.generated.ts

if ! git diff --cached --quiet -- common/ux/tokens.generated.css \
    common/ux/Const/Const.generated.ts src/shared/styles/tokens.generated.scss \
    rules/tokens.generated.ts; then
    printf '\033[36m%s\033[0m\n' "[commit-tokens] mirrors regenerated and staged"
fi

# The installed tree is derived from the lockfile, so this gate repairs it before the gates
# below read it, for the same reason the token mirrors above are repaired.
step "[commit-dependency-install]" node "$root/scripts/check-dependency-install.js"

# The bump gate answers 2 when it needs a decision. Git hands a hook a stdin that is not a
# terminal, so the question is read from the console device instead. The bump stands if a later
# gate fails: the retry finds a valid bump against HEAD and asks nothing.
printf '\033[36m%s\033[0m\n' "[commit-version]"
status=0
node "$root/scripts/check-version-bump.js" || status=$?

if [ "$status" -eq 2 ]; then
    while :; do
        printf 'Choose option: '
        if ! read -r answer < /dev/tty; then
            printf '\033[31m%s no terminal to answer on\033[0m\n' "[commit-version]"
            exit 1
        fi

        case "$answer" in
            1|2|3) break ;;
            q|Q) exit 1 ;;
            *) printf '\033[31m%s not a choice — 1, 2, 3 or q\033[0m\n' "[commit-version]" ;;
        esac
    done

    status=0
    node "$root/scripts/check-version-bump.js" "$answer" || status=$?
fi

if [ "$status" -ne 0 ]; then
    printf '\033[31m%s Failed ✗\033[0m\n' "[commit-version]"
    exit 1
fi

printf '\033[32m%s Successful ✓\033[0m\n' "[commit-version]"
