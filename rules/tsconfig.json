{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "outDir": "./dist",
        "noEmit": false,
        "declaration": false,
        "sourceMap": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["dist", "**/*.spec.ts", "tests/**", "**/*.js"]
}
