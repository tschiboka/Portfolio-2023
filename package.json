{
    "name": "portfolio-2023",
    "version": "2.7.0",
    "private": true,
    "authour": "Tivadar Debnar",
    "type": "module",
    "workspaces": [
        "common",
        "server"
    ],
    "description": "Tivadar Debnar - Frontend Developer: Portfolio Website with Blog and Articles.",
    "keywords": [
        "portfolio",
        "frontend",
        "react"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tschiboka/Portfolio-2023"
    },
    "bugs": {
        "url": "https://github.com/tschiboka/Portfolio-2023/issues"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "start": "npm run start --workspace server",
        "dev": "node scripts/generate-version-dev.js && vite",
        "tsc": "tsc",
        "build": "tsc && vite build && node scripts/generate-version.js",
        "build:rules": "tsc -p rules/tsconfig.json && node rules/dist/rules/builder.js",
        "build:tokens": "node scripts/build-tokens.js",
        "check:tokens": "node scripts/build-tokens.js --check",
        "lint": "npm run check:tokens && npm run build:rules && eslint src server common rules scripts --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@hookform/resolvers": "7.0.2",
        "@tanstack/react-query": "5.106.1",
        "axios": "1.21.0",
        "detectincognitojs": "1.9.0",
        "howler": "2.2.4",
        "monet": "0.9.3",
        "nanoid": "6.0.2",
        "ramda": "0.32.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hook-form": "7.91.0",
        "react-icons": "5.7.0",
        "react-router-dom": "7.18.5",
        "react-share": "6.1.0",
        "react-syntax-highlighter": "16.1.2",
        "react-use-websocket": "4.13.0",
        "yup": "1.7.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/css-tree": "3.2.0",
        "@types/express": "5.0.6",
        "@types/howler": "2.2.13",
        "@types/ramda": "0.32.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/react-syntax-highlighter": "15.5.13",
        "@types/sizzle": "2.3.10",
        "@types/unist": "3.0.3",
        "@typescript-eslint/types": "8.72.1",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitejs/plugin-react": "6.2.1",
        "@vitest/coverage-v8": "5.1.0",
        "css-tree": "3.2.1",
        "eslint": "10.14.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "husky": "9.1.7",
        "jsdom": "31.0.0",
        "msw": "3.0.4",
        "sass": "1.108.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "overrides": {
        "eslint-plugin-react": {
            "eslint": "$eslint"
        }
    }
}
