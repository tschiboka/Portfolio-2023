{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["vitest/globals"],
        /* WARNING! A new alias belongs in vite.config.ts, jest.config.cjs and
           rules/import-order/ImportOrder.constants.ts too. */
        "paths": {
            "@app": ["./src/app"],
            "@app/*": ["./src/app/*"],
            "@portfolio": ["./src/portfolio"],
            "@portfolio/*": ["./src/portfolio/*"],
            "@projects": ["./src/projects"],
            "@projects/*": ["./src/projects/*"],
            "@common-types": ["./common/types"],
            "@common-types/*": ["./common/types/*"],
            "@common-ux": ["./common/ux"],
            "@common-ux/*": ["./common/ux/*"],
            "@common-utils": ["./common/utils"],
            "@common-utils/*": ["./common/utils/*"],
            "@common-mocks": ["./common/mocks"],
            "@common-mocks/*": ["./common/mocks/*"],
            "@shared-styles": ["./src/shared/styles"],
            "@shared-styles/*": ["./src/shared/styles/*"],
            "@shared-queries": ["./src/shared/queries"],
            "@shared-queries/*": ["./src/shared/queries/*"],
            "@shared-assets": ["./src/shared/assets"],
            "@shared-assets/*": ["./src/shared/assets/*"],
            "@shared-components": ["./src/shared/components"],
            "@shared-components/*": ["./src/shared/components/*"],
            "@shared-context": ["./src/shared/context"],
            "@shared-context/*": ["./src/shared/context/*"],
            "@public": ["./public"],
            "@public/*": ["./public/*"]
        },

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src", "common", "rules", "public/source/projects"],
    "references": [{ "path": "./tsconfig.node.json" }]
}
